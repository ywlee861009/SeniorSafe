# Supabase project settings (from Dashboard > Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Device JWT signing secret. NOT named SUPABASE_JWT_SECRET because Supabase
# reserves the SUPABASE_ prefix for function secrets. Any random value works as
# long as it is consistent — Edge Functions sign and verify device tokens with it.
DEVICE_JWT_SECRET=your-random-device-jwt-secret

# FCM (Firebase Cloud Messaging) - for inactivity push notifications
# Primary (required for real delivery): the full service account JSON as a
# single line. Firebase Console > Project settings > Service accounts >
# Generate new private key. Set in prod via:
#   supabase secrets set FIREBASE_SERVICE_ACCOUNT="$(cat service-account.json)"
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Fallback only — legacy FCM HTTP API was shut down by Google in 2024 (dead path).
FIREBASE_SERVER_KEY=your-firebase-server-key

# Cron secret (for internal batch calls)
CRON_SECRET=your-random-cron-secret
